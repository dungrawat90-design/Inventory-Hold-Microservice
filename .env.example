# OPTIONAL. docker compose works without a .env file; these are the defaults it uses.
# Copy this file to .env only to change a value. .env is git-ignored.

# Development-only secrets. Change both for any shared environment.
API_KEY=dev-only-api-key-0123456789
RABBITMQ_USER=hold
RABBITMQ_PASSWORD=dev-only-rabbit-password

# Host ports (change one if it is already taken on your machine).
WEB_PORT=8081
API_PORT=5080
RABBITMQ_UI_PORT=15672
MONGO_PORT=27017

# Behaviour.
SEED_DEMO_DATA=true
HOLD_DEFAULT_TTL_MINUTES=15
HOLD_EXPIRY_INTERVAL_SECONDS=15

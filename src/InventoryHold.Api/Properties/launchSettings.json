{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "InMemory demo (no MongoDB/Redis/RabbitMQ)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Demo__InMemory": "true",
        "Holds__ExpiryIntervalSeconds": "5"
      }
    },
    "Real infrastructure (localhost)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Seed__Enabled": "true"
      }
    }
  }
}

server {
  listen 80;
  server_tokens off;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

  # The API key is added here, on the server side, so the browser never holds it.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Api-Key "${API_KEY}";
    proxy_set_header X-Correlation-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  location /health {
    access_log off;
    return 200 "ok";
    add_header Content-Type text/plain;
  }

  location / {
    try_files $uri /index.html;
  }
}
